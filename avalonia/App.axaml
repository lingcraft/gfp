<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Gfp.Mobile.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <!-- ⚠ 必须内嵌字体，且必须显式指定给控件。
         原因：Android 上 Skia 只暴露 34 个具名字体族（sans-serif-* / source-sans-pro），
         没有一个含 CJK 字形 —— MatchFamily("sans-serif") 对 '你'(U+4F60) 返回字形 id 0，
         "Noto Sans CJK SC" 等名字直接返回 null（/system/fonts/NotoSansCJK-Regular.ttc 是以
         fonts.xml 的 <family lang="zh-Hans"> 语言回退形式注册的，不是具名字体族）。
         实测「不指定 FontFamily 让 Skia 自己回退」也不行，ComboBox 照样豆腐块。
          字体为子集化版「微软雅黑」（msyh.ttc 的 index 0 = Microsoft YaHei，
         ASCII + GB2312，7546 字，1.74MB；脚本 temp\subset_yahei.py）。
         若要换成观感与系统一致的免费字体，可用 Noto Sans CJK SC 子集
         （temp\subset_noto.py 会从模拟器的 NotoSansCJK-Regular.ttc 提取 index 2）。 -->
    <FontFamily x:Key="AppFont">avares://gfp-mobile/Assets/Fonts/msyh-subset.ttf#Microsoft YaHei</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- ⚠ FontFamily 不是 Control 上的属性：
           · TextBlock 走 TextElement.FontFamily
           · ComboBox / TextBox / Button 等走 TemplatedControl.FontFamily
         :is() 才会匹配子类；直接写类型名是精确匹配。 -->
    <Style Selector=":is(TextElement)">
      <Setter Property="TextElement.FontFamily" Value="{StaticResource AppFont}" />
    </Style>
    <Style Selector=":is(TemplatedControl)">
      <Setter Property="TemplatedControl.FontFamily" Value="{StaticResource AppFont}" />
    </Style>
  </Application.Styles>

</Application>
