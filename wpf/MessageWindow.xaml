<Window x:Class="Gfp.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F0F0F0"
        MinWidth="220">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="14,14,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IconBox" Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock x:Name="MsgText" Grid.Column="1" TextWrapping="Wrap"
                       VerticalAlignment="Center" MaxWidth="380" FontSize="12" />
        </Grid>
        <StackPanel x:Name="Buttons" Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="14,6,14,14" />
    </Grid>
</Window>
