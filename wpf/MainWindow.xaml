<Window x:Class="Gfp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="功夫派怀旧服存档工具"
        Width="529" Height="134"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">
    <Canvas>
        <TextBox x:Name="_path" Canvas.Left="6" Canvas.Top="9" Width="499" Height="18" Padding="0"
                 BorderThickness="0" Background="Transparent" IsReadOnly="True"
                 FocusVisualStyle="{x:Null}"
                 VerticalContentAlignment="Center" FontFamily="Microsoft YaHei" FontSize="12"
                 Text="存档位置：" />
        <Label x:Name="_lblAcc" Canvas.Left="8" Canvas.Top="40" Padding="0" Content="账号：" />
        <ComboBox x:Name="_acc" Canvas.Left="45" Canvas.Top="36" Width="80" Height="24" />
        <Label x:Name="_lblRole" Canvas.Left="131" Canvas.Top="40" Padding="0" Content="角色：" />
        <ComboBox x:Name="_char" Canvas.Left="168" Canvas.Top="36" Width="170" Height="24" />
        <Button x:Name="_relief" Canvas.Left="344" Canvas.Top="36" Width="50" Height="24" Content="减负"
                ToolTip="给予&lt;=10级的角色缺少的鲲鹏套装装备" />
        <Button x:Name="_export" Canvas.Left="400" Canvas.Top="36" Width="50" Height="24" Content="导出"
                ToolTip="导出账号存档到桌面" />
        <Button x:Name="_import" Canvas.Left="456" Canvas.Top="36" Width="50" Height="24" Content="导入"
                ToolTip="导入账号存档到游戏" />
        <Label x:Name="_lblBak" Canvas.Left="8" Canvas.Top="70" Padding="0" Content="备份：" />
        <ComboBox x:Name="_bak" Canvas.Left="45" Canvas.Top="66" Width="293" Height="24" />
        <Button x:Name="_backup" Canvas.Left="344" Canvas.Top="66" Width="50" Height="24" Content="备份"
                ToolTip="备份账号存档" />
        <Button x:Name="_restore" Canvas.Left="400" Canvas.Top="66" Width="50" Height="24" Content="恢复"
                ToolTip="恢复账号备份存档" />
        <Button x:Name="_delete" Canvas.Left="456" Canvas.Top="66" Width="50" Height="24" Content="删除"
                ToolTip="删除账号备份存档" />
    </Canvas>
</Window>
