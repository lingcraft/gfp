<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 全局 Window 基础（Fusion 底色/字体） ===== -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Background" Value="#F0F0F0" />
    </Style>

    <!-- ===== Button：Fusion 风格 ===== -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" BorderThickness="1" CornerRadius="2"
                            BorderBrush="#ABABAB">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FDFDFD" Offset="0" />
                                <GradientStop Color="#EEEEEE" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#8A8A8A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#D3D3DC" />
                        </Trigger>

                        <!-- 聚焦 或 默认 按钮：浅紫边框+背景 -->
                        <!-- IsKeyboardFocused：鼠标/键盘聚焦的按钮变紫（基础行为） -->
                        <!-- IsDefaulted：弹窗打开时的默认选项也变紫；切到别的程序窗口失活时两者皆 false，恢复灰 -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#7170D0" />
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FDFDFD" Offset="0" />
                                        <GradientStop Color="#E5E5EE" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#7170D0" />
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FDFDFD" Offset="0" />
                                        <GradientStop Color="#E5E5EE" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- 聚焦按钮 hover：背景略加深（保持紫边） -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F7F6FC" Offset="0" />
                                        <GradientStop Color="#DFDFED" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <!-- 默认按钮 hover：背景略加深（保持紫边） -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefaulted" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F7F6FC" Offset="0" />
                                        <GradientStop Color="#DFDFED" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <!-- 聚焦按钮 pressed：背景变灰（保持紫边），对齐 PySide6 Fusion -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="#D3D3DC" />
                        </MultiTrigger>
                        <!-- 默认按钮 pressed：背景变灰（保持紫边），对齐 PySide6 Fusion -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefaulted" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="#D3D3DC" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox：Fusion 风格（完全模板化，替代子类化） ===== -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderBrush" Value="#ABABAB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#F0F0F0" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="FontFamily" Value="Microsoft YaHei" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="Background" Value="#F0F0F0" />
                    <Setter Property="MinHeight" Value="24" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="6,0,6,0">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#6B69D6" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- 下拉按钮（占满整个控件，承载边框+渐变底） -->
                        <ToggleButton x:Name="ToggleButton" Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate>
                                    <Border x:Name="bd" BorderThickness="1" CornerRadius="2"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FDFDFD" Offset="0" />
                                                <GradientStop Color="#EEEEEE" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- 悬停：只换边框，背景不动 -->
                                        <Trigger Property="ToggleButton.IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#8A8A8A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- 聚焦覆盖层：盖在 ToggleButton 之上，却排在 ContentPresenter / 箭头之前，
                             因此只覆盖「边框 + 底色」那一层，文字与箭头照常显示。
                             为什么不用触发器直接改 bd：bd 在 ToggleButton 的内层模板里，ComboBox
                             模板的 TargetName 够不到它，而 RelativeSource AncestorType 在那层模板里
                             也解析不到 ComboBox（实测聚焦时边框纹丝不动）。覆盖层与本模板同层，
                             TargetName 直接可达。色值对齐 Button 的 IsKeyboardFocused 与 Python 版
                             ComboHoverStyle 的 FOCUS_BORDER / FOCUS_BG。 -->
                        <Border x:Name="FocusOverlay" Grid.ColumnSpan="2" CornerRadius="2"
                                BorderThickness="1" BorderBrush="#7170D0"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FDFDFD" Offset="0" />
                                    <GradientStop Color="#E5E5EE" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,20,0" />
                        <Path x:Name="ArrowDown" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,9,0" Fill="#4F4F4F" Data="M0,0 L9,0 L4.5,5 Z" />
                        <Path x:Name="ArrowUp" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,9,0" Fill="#4F4F4F" Data="M0,5 L9,5 L4.5,0 Z" Visibility="Collapsed" />
                        <Popup x:Name="Popup" Placement="Bottom" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Width="{TemplateBinding ActualWidth}">
                            <Border BorderThickness="1" BorderBrush="#ABABAB" Background="#F0F0F0">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 聚焦：显示紫边框 + 紫底覆盖层（对齐 Button 的 IsKeyboardFocused，
                             也就是 Python 版 ComboHoverStyle 的聚焦外观） -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusOverlay" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- 聚焦 + 悬停：底色略加深、边框保持紫（对应 Python 版 FOCUS_HOVER_BG） -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusOverlay" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F7F6FC" Offset="0" />
                                        <GradientStop Color="#DFDFED" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ArrowDown" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ArrowUp" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#888888" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
