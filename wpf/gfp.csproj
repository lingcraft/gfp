<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- 内嵌的 7z.dll 为 x64，锁定平台避免在 32 位进程加载失败 -->
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Gfp</RootNamespace>
    <AssemblyName>gfp</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <!-- 声明支持 Win10/11：让 DWM 用新式标题栏按钮（与 PySide6 版一致） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>功夫派怀旧服存档工具</AssemblyTitle>
    <Product>功夫派怀旧服存档工具</Product>
    <Version>1.2.0</Version>
    <!-- 目录变成 git 仓库后，SDK 内置 SourceLink 会把提交哈希以 `+<hash>` 追加到
         InformationalVersion（资源管理器"产品版本"）后面；关掉保持版本号干净。 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- "产品版本"=InformationalVersion，默认 3 段 `1.2.1`；补 .0 变成和 FileVersion 一致的 4 段 -->
    <InformationalVersion>$(Version).0</InformationalVersion>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 装备库 JSON 内嵌进 exe（对应 Rust 版的 include_str!） -->
    <EmbeddedResource Include="..\装备\*.json">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SevenZipExtractor" Version="1.0.19" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 7z.dll（7-Zip 26.03 x64）gzip 压缩后内嵌，Core/SevenZip.cs 首次使用时释放加载。
         原始 7z.dll 保留在同目录，仅用于重新生成此 .gz（更改 7-Zip 版本时替换并重新压缩）。 -->
    <EmbeddedResource Include="7z.dll.gz">
      <LogicalName>gfp.sevenzip.gz</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- SevenZipExtractor 的 build/*.targets 会把包自带的 x64/x86 原生 7z.dll（24.07）拷进输出目录，
       我们用的是内嵌的 26.03（运行期释放到 %LOCALAPPDATA%\gfp），这里把它们排除，保持输出目录干净。 -->
  <Target Name="DropSevenZipExtractorNativeLibs" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(NativeLibs)" />
      <NativeLibs Remove="@(NativeLibs)" />
    </ItemGroup>
  </Target>

</Project>
